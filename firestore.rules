rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner = the admin's Google account
    // TEMPLATE: 아래 이메일을 본인 Google 계정으로 교체하세요 (src/site.config.js의 ownerEmail과 일치)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'kiimjiyun0922@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isVisitor() {
      return request.auth != null
        && request.auth.token.visitor == true
        && request.auth.token.accessExpiresAt is number
        && request.time.toMillis() < request.auth.token.accessExpiresAt;
    }

    function isPublicConfig(doc) {
      return doc in ['authgate', 'theme_settings'];
    }

    function isPortfolioContent(doc) {
      return doc in [
        'hero',
        'resume',
        'contact',
        'about',
        'achievements',
        'journey',
        'projects',
        'case_studies'
      ];
    }

    match /site/{doc} {
      // The entry screen needs only these non-sensitive settings before login.
      allow read: if isOwner() || isPublicConfig(doc)
        || (isVisitor() && isPortfolioContent(doc));

      // Tokens, analytics, and all content mutations remain owner-only.
      // Visitor analytics should be accepted by a trusted server endpoint,
      // not by granting clients permission to overwrite shared log documents.
      allow write: if isOwner();

      // Version history snapshots: owner only (read and write)
      match /history/{snap} {
        allow read, write: if isOwner();
      }
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

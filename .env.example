VITE_ANTHROPIC_API_KEY=your-api-key-here

# Admin 빌드타임 인증 (node scripts/gen-admin-hash.mjs 로 생성)
VITE_ADMIN_SALT=
VITE_ADMIN_HASH=

# Firebase (Firestore 데이터 동기화)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── 사이트 정체성 (템플릿: src/site.config.js 기본값을 덮어씀) ──
VITE_SITE_URL=
VITE_OWNER_NAME=
VITE_OWNER_EMAIL=
VITE_CONTACT_EMAIL=

# 보안 알림 이메일 (EmailJS — 선택. SERVICE를 비우면 비활성화)
VITE_EMAILJS_SERVICE=
VITE_EMAILJS_TEMPLATE=
VITE_EMAILJS_PUBLIC_KEY=

# 어드민 URL 경로 커스텀 (선택 — 미설정 시 ADMIN_HASH 앞 12자)
VITE_ADMIN_PATH=

# 로컬 개발에서만 기존 브라우저 토큰 검증 허용 (운영에서는 반드시 false/미설정)
VITE_ALLOW_CLIENT_TOKEN_FALLBACK=false

# ── 서버 (Vercel 환경변수로만 설정, 클라이언트 노출 금지) ──
# Firebase 서비스 계정 JSON 전체 (api/verify-token.js의 서버측 토큰 검증)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
